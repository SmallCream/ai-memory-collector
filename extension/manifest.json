{
  "manifest_version": 3,
  "name": "AI Memory Collector",
  "version": "0.4.3",
  "description": "按平台和账号自动备份 ChatGPT、豆包对话与受支持资源到本地，支持增量采集、缺失补齐及可选私有 GitHub 同步。",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "sidePanel",
    "alarms",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://www.doubao.com/*",
    "https://api.github.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.byteimg.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 AI Memory Collector"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "panel.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https:"
  }
}
